# AlfaGen PII Gateway — placeholder environment variables.
# NO real secrets here. Values are placeholders only.

# Vault backend: "memory" (single-process local mode) or "redis" (multiworker).
# MemoryVault is forbidden with PII_WORKERS>1 (fail fast, no silent fallback).
PII_VAULT_BACKEND=memory
PII_VAULT_TTL_SECONDS=3600
PII_VAULT_MAX_ENTRIES=100000
PII_VAULT_MAX_BYTES=1073741824
# AEAD key for stored mappings (base64, 32 bytes). REQUIRED when backend=redis.
# Empty placeholder — set a real value in deployment.
PII_VAULT_KEY=
# Redis connection URL for the shared Vault (multiworker).
PII_VAULT_REDIS_URL=redis://127.0.0.1:6379/0
# Number of uvicorn workers. Must be 1 when PII_VAULT_BACKEND=memory.
PII_WORKERS=1
# NER intra-op CPU threads, capped at available CPUs; context/NLI stays at one.
PII_NER_THREADS=4
# HTTP idle connection lifetime; separate from the 9-second processing deadline.
UVICORN_TIMEOUT_KEEP_ALIVE=30

# Demo consumer API keys (placeholders). Set real values in deployment.
SUPPORT_DEMO_API_KEY=
ANALYTICS_DEMO_API_KEY=
COMBINATION_DEMO_API_KEY=
DEMO_CHAT_API_KEY=

# Optional AlfaGen provider (NOT used by default; demo uses an explicit stub).
ALFAGEN_BASE_URL=
ALFAGEN_MODEL=
ALFAGEN_API_KEY=

# Limits
PII_MAX_BODY_BYTES=2097152
PII_MAX_IN_FLIGHT=8
# Server-side processing deadline. Keep below the 10-second checker timeout.
PII_MAX_PROCESSING_SECONDS=9

# Protects POST /config/update. Leave empty to disable configuration updates.
PII_CONFIG_UPDATE_KEY=
